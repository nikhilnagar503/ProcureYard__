# Local development password for the Postgres container.
# Change it if you want; never commit your actual .env file.
POSTGRES_PASSWORD=postgres

# App database URL for running Node.js directly outside Docker.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/procureyard

# App runtime settings.
PORT=8000
DATA_DIR=./data

# Groq is used only to understand rider messages and draft replies.
# Add your own key locally; never commit the real .env file.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=25

# PaySwift sandbox URL when running Node directly on your Mac.
PAYSWIFT_BASE_URL=http://localhost:8081
PAYSWIFT_TIMEOUT_MS=15000

# Local operations reviewer key. Required for approve/reject actions in /ops.
# Use a private value of at least 16 characters and never commit .env.
OPS_API_KEY=replace-with-a-private-key-at-least-16-characters
