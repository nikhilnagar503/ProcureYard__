# Local development password for the Postgres container.
# Change it if you want; never commit your actual .env file.
POSTGRES_PASSWORD=postgres

# App database URL for running Node.js directly outside Docker.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/procureyard

# App runtime settings.
PORT=8000
DATA_DIR=./data

# Groq is used only to understand rider messages and draft replies.
# Add your own key locally; never commit the real .env file.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=7
